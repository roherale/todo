# Copy to .env for local development: cp .env.example .env
# .env is never committed. Put real values only in your own .env.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# The database from docker-compose.yml. Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Where the app is reached in the browser. The sign-in redirects come back to
# ${APP_ORIGIN}/auth/callback and ${APP_ORIGIN}/signed-out: register both in the sign-in provider.
# Optional (this is the default).
APP_ORIGIN=http://localhost:8080

# The built web app, served by the API at APP_ORIGIN. A relative path is read from packages/api
# (build it with: pnpm --filter @todo/web build).
# Optional: without it the API runs alone.
WEB_DIST_DIR=../web/dist/web/browser

# Sign-in provider (staging). All optional in development: without them, web sign-in
# and bearer tokens do not work, but the API still starts.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# The issuer, JWKS address and audience that tokens are checked against.
WORKOS_ISSUER=
WORKOS_JWKS_URL=
WORKOS_AUDIENCE=

# Encrypts stored refresh tokens: 32 random bytes, base64. Generate one with:
#   openssl rand -base64 32
# Optional in development (a random key is used per run, so web sessions end on every restart).
SESSION_ENCRYPTION_KEY=

# Comma-separated emails that may sign up. Optional in development (empty means nobody can sign up).
ALLOWED_SIGNUP_EMAILS=

# The command line tool's client id at the sign-in provider. Optional.
CLI_CLIENT_ID=
