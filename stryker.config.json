{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "packages/api/src/modules/**/*.service.ts",
    "packages/api/src/modules/**/*.repository.ts"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 4
}